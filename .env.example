# NEXUS Environment Configuration Template
# Copy to .env or backend/.env

# Application
PROJECT_NAME="NEXUS"
VERSION="2.0.0"
PORT=8000
DEMO_MODE=true

# Database (Default: Local SQLite async engine; Production: Supabase PostgreSQL)
DATABASE_URL="sqlite:///./nexus.db"
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Google Gemini Multimodal AI (Optional - Intelligent explainable fallback active if omitted)
GEMINI_API_KEY=""

# Supabase Auth & Storage (Optional - Local mock auth active if omitted)
SUPABASE_URL=""
SUPABASE_KEY=""

# JWT Security
JWT_SECRET="nexus-super-secret-key-2026-kerala-secure"
